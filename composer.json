{
    "name": "brannow/envyml",
    "type": "library",
    "description": "Registers environment variables from a env.yml file",
    "keywords": ["environment", "env", "yaml", "dotenv"],
    "homepage": "https://symfony.com",
    "license" : "MIT",
    "authors": [
        {
            "name": "Benjamin Rannow",
            "email": "b.rannow@familie-redlich.de"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/cache": "7.*",
        "symfony/process": "7.*",
        "symfony/yaml": "7.*",
        "symfony/runtime": "7.*"
    },
    "replace": {
        "symfony/dotenv": "^7.0"
    },
    "autoload": {
        "psr-4": { "Brannow\\Component\\Envyml\\": "" }
    },
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": { }
}
